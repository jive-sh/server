{
  "$schema": "./package.schema.json",
  "name": "@jive-sh/server",
  "description": "Jive's central server: the Convex backend that holds accounts, passkeys and sessions, organizations, code repositories, connections and packages; people sign in with jive.sh passkeys, programs through sign-in requests, and pipelines provision packages with their GitHub Actions ID token.",
  "version": "0.10.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "jive:cicd:get-config": "jive-backend-convex cicd get-config",
    "jive:cicd:build": "jive-backend-convex cicd build",
    "jive:cicd:audit": "tsc --noEmit -p tsconfig.json && bun test",
    "jive:cicd:deploy:plan": "jive-backend-convex cicd deploy-plan",
    "jive:cicd:upload-artifacts": "jive-backend-convex cicd upload-artifacts",
    "jive:cicd:deploy": "jive-backend-convex cicd deploy",
    "dev": "jive-backend-convex dev",
    "connect-npm": "bun scripts/connect-npm/main.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "convex": "^1.48.0",
    "effect": "^4.0.0",
    "friendly-words": "^1.3.1",
    "jive-resource-connector-package-registry-npm": "^0.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/friendly-words": "^1.2.2",
    "jive-abstract-backend-convex": "^0.5.0",
    "typescript": "^5.9.3"
  },
  "jive": {
    "cicd": {
      "deploy": {
        "verb": "Deploy to",
        "branches": {
          "main": [
            "latest"
          ]
        },
        "previews": false,
        "sequentially": true
      },
      "runsOnPullRequests": true,
      "runsOn": "ubuntu-latest",
      "requiredSecrets": [
        "CONVEX_TEAM_ACCESS_TOKEN",
        "NPM_TOKEN"
      ]
    },
    "backend-convex": {
      "team": 551884,
      "project": "jive-server",
      "clientPackageName": "@jive-sh/server-client",
      "region": "aws-us-east-1",
      "environments": {
        "latest": {
          "environmentVariables": {
            "WEBSITE_DOMAIN": {
              "value": "jive.sh"
            },
            "GITHUB_ACTIONS_JWKS": {
              "value": "https://token.actions.githubusercontent.com/.well-known/jwks"
            },
            "CONNECTION_KEY": {
              "generateOnce": {
                "type": "randomBytes",
                "bytes": 32,
                "prefix": "1:"
              }
            }
          },
          "customDomains": [
            {
              "domain": "api.jive.sh",
              "destination": "convexCloud",
              "canonical": true
            }
          ]
        }
      },
      "afterDeploy": { "function": "ssh:migrateToAccountKeys" },
      "provisionWithJive": null
    }
  }
}
